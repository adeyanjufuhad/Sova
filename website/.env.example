# Copy to .env.local for development. All values are public (they end up in the
# static site), so never put secrets here.

# Public URL of the site, used for social previews
NEXT_PUBLIC_SITE_URL=https://sova.rumptycloud.app

# The live web app ("Try the live demo")
NEXT_PUBLIC_APP_URL=https://sova-app.rumptycloud.app

# The Sova API; the waitlist form posts to $NEXT_PUBLIC_API_URL/waitlist.
# The API must list this site's address in CORS_ORIGINS.
NEXT_PUBLIC_API_URL=https://sova-api.rumptycloud.app

# Leave empty until the app is live on Google Play
NEXT_PUBLIC_PLAY_STORE_URL=
