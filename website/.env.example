# Supabase project (Settings > API). The anon key is safe to expose: RLS only allows inserts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site, used for social previews
NEXT_PUBLIC_SITE_URL=https://sova.vercel.app

# Leave empty until the app is live on Google Play
NEXT_PUBLIC_PLAY_STORE_URL=
