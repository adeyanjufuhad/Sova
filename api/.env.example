# Copy to .env for local development (npm scripts load it automatically).
# On RumptyCloud, set these in the service's environment instead.
# Never put real values in this file: it is committed to git.

# development | test | production
NODE_ENV=development

# Interface and port to listen on. 8080 is the default.
HOST=0.0.0.0
PORT=8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Postgres connection string. On RumptyCloud use the INTERNAL connection string,
# with the restricted sova_app user (see `npm run db:create-app-role`).
# Leave empty to run without a database (only /health works).
DATABASE_URL=

# TLS to Postgres: auto | disable | no-verify | verify
# auto follows ?sslmode= in the URL (require = encrypt without verifying the certificate,
# which RumptyCloud's self-signed public endpoint needs).
DATABASE_SSL=auto
# PEM certificate to verify the server when DATABASE_SSL=verify.
DATABASE_CA_CERT=

# Admin connection used only by `npm run migrate`, `npm run seed` and
# `npm run db:create-app-role`. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# Apply pending migrations at startup (only if the API's role may run DDL).
RUN_MIGRATIONS_ON_START=false

# Browser origins allowed to call the API (the deployed app and website), comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3300

# --- Auth -------------------------------------------------------------------
# Signs access tokens and hashes OTP codes. At least 32 random characters; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# test-numbers (free: fixed codes for whitelisted phones) | sms (paid provider, not wired yet)
OTP_PROVIDER=test-numbers
# Whitelist for test-numbers, comma-separated phone:code pairs.
OTP_TEST_NUMBERS=+2348000000001:123456
OTP_TTL_SECONDS=300

# "Try the demo" signs into the seeded demo account (npm run seed).
DEMO_LOGIN_ENABLED=true
DEMO_PHONE=+2348000000000
# Private demo copies kept built in advance, so "Try the demo" is instant (0 = build each on demand).
DEMO_SPARES=1

# --- Receipt photos -----------------------------------------------------------
# S3-compatible private bucket (RumptyCloud: Buckets > your bucket > Access keys).
# Photo uploads are off until all five are set.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Ask Sova (AI) ------------------------------------------------------------
# OpenAI-compatible chat API: RumptyCloud AI inference (console > AI inference > API keys).
# "Ask Sova" is off until AI_API_KEY is set. Prompts hold circle facts with first
# names and initials only: never phones, bank details or PINs.
AI_BASE_URL=https://chat.rumptycloud.com/v1
AI_API_KEY=
AI_MODEL=llama3.2:3b
AI_TIMEOUT_MS=25000
# Daily limits (days in Lagos, counted in the database): answers per member,
# and for the whole service so the free inference allowance (1M tokens a cycle) lasts.
AI_DAILY_LIMIT=20
AI_DAILY_TOTAL=60
