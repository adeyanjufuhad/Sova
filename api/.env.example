# Copy to .env for local development. On RumptyCloud, set these in the service's environment.

# development | test | production
NODE_ENV=development

# Interface and port to listen on. RumptyCloud provides the port; 8080 is the default.
HOST=0.0.0.0
PORT=8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres connection string. On RumptyCloud use the database's internal connection string.
# Leave empty to run without a database (only /health works).
DATABASE_URL=

# Browser origins allowed to call the API (the deployed app and website), comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3300
